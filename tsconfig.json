{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"lib": ["ESNext"],
		"types": ["node", "bun"],
		"rootDir": "./src",
		"outDir": "./dist",
		"paths": {
			"@/*": ["./src/*"]
		},
		"strict": true,
		"useUnknownInCatchVariables": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"rewriteRelativeImportExtensions": true,
		"strictPropertyInitialization": false
	}
}
